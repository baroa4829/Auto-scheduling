# Claude API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# 웹훅 보호용 임의의 긴 문자열 (휴대폰 자동화 앱에도 똑같이 입력)
AUTOSCHEDULER_WEBHOOK_TOKEN=change-me-to-a-long-random-string
# 일정을 넣을 캘린더 (primary = 기본 캘린더, 또는 캘린더 ID)
AUTOSCHEDULER_CALENDAR_ID=primary
AUTOSCHEDULER_TIMEZONE=Asia/Seoul
# 확정되지 않은(제안 단계) 약속도 등록할지: true면 제목 앞에 [미정]을 붙여 등록
AUTOSCHEDULER_INCLUDE_TENTATIVE=false
# 실제 캘린더에 쓰지 않고 로그만 출력 (처음 테스트할 때 true 권장)
AUTOSCHEDULER_DRY_RUN=false
AUTOSCHEDULER_DATA_DIR=data
